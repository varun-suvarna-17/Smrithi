# ==============================================
# SMRITHI Backend Environment Configuration
# ==============================================

# Server Settings
APP_NAME=SMRITHI_Backend
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security / Authentication (JWT)
SECRET_KEY=smrithi-secret-key-change-this-in-production-ner-sih26003
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# MongoDB Connection String (e.g. mongodb://localhost:27017 or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=smrithi_db
# Set to True to use automatic in-memory persistence when MongoDB server is not active
USE_IN_MEMORY_FALLBACK=True

# Optional External AI API Key (e.g., Google Gemini / OpenAI) for Progress Report Summaries
# When omitted, the built-in deterministic clinical intelligence engine generates the structured report
GEMINI_API_KEY=
OPENAI_API_KEY=

# Audio / TTS Cache Directory
AUDIO_CACHE_DIR=./audio_cache

# ==============================================
# SMRITHI Frontend Environment Configuration
# ==============================================

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=SMRITHI - Caregiver Assistant

# Logging
VITE_LOG_LEVEL=debug
