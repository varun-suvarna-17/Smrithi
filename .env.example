# ==============================================
# SMRITHI Backend Environment Configuration
# ==============================================

# Server Settings
APP_NAME=SMRITHI_Backend
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security / Authentication (JWT)
SECRET_KEY=smrithi-secret-key-change-this-in-production-ner-sih26003
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration - Choose One:
# Option 1: Firebase Firestore (Production - Recommended)
FIREBASE_CRED_PATH=./serviceAccountKey.json
# Set this to False to FORCE use of Firebase (won't fallback to in-memory)
USE_IN_MEMORY_FALLBACK=True

# Option 2: MongoDB (Optional - if Firebase not available)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=smrithi_db

# Optional External AI API Key (e.g., Google Gemini / OpenAI) for Progress Report Summaries
# When omitted, the built-in deterministic clinical intelligence engine generates the structured report
GEMINI_API_KEY=
OPENAI_API_KEY=

# Audio / TTS Cache Directory
AUDIO_CACHE_DIR=./audio_cache

# ==============================================
# SMRITHI Frontend Environment Configuration
# ==============================================

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=SMRITHI - Caregiver Assistant

# Firebase Web SDK Configuration (Optional - for client-side Firebase features)
# Get these from Firebase Console → Project Settings → General → Your Apps
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Logging
VITE_LOG_LEVEL=debug
