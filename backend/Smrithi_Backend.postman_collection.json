							"mode": "raw",
							"raw": "{\n  \"email\": \"ananya.caregiver@smrithi.org\",\n  \"password\": \"SmrithiCare#2026\",\n  \"full_name\": \"Ananya Sharma\",\n  \"role\": \"caregiver\",\n  \"phone\": \"+91-9876543210\"\n}"
