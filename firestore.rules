rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Everything is caregiver-scoped.
    // Only the authenticated caregiver can read or write their own root doc
    // and all nested subcollections (patients, gameSessions, reminders, engagementSummary).

    match /caregivers/{caregiverId} {
      allow read, write: if request.auth != null && request.auth.uid == caregiverId;

      match /patients/{patientId}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == caregiverId;
      }
    }

    // Deny everything else (belt-and-suspenders default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

